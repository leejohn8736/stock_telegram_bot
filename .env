# 텔레그램 봇 토큰 (BotFather에게 발급받은 토큰 입력)
TELEGRAM_BOT_TOKEN=여기에_텔레그램_봇_토큰_입력

# 텔레그램 채팅 ID (선택 또는 필요 시 입력)
TELEGRAM_CHAT_ID=

# 스캔 및 체크 주기 설정 (초 단위, 기본값: 1시간)
CHECK_INTERVAL=3600
PRICE_CHECK_INTERVAL=60

# JSONbin.io 클라우드 데이터베이스 설정 (SQLite 대체용 영구 저장소)
JSONBIN_API_KEY=여기에_아까_복사한_X-MASTER-KEY_입력
JSONBIN_BIN_ID=여기에_사용할_Bin_ID_입력

# (선택) 토스증권 Open API 설정 (미설정 시 Yahoo Finance로 자동 폴백)
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
